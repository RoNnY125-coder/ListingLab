# Copy this file to .env and fill in your real values.
# NEVER commit .env — it contains your Cloudinary secret.

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# URL of the Next.js frontend (used for CORS)
# Development default is already set in code; override here for production.
FRONTEND_URL=http://localhost:3000
